#!/usr/bin/env python3
"""intercept — adaptive, fail-open decision gates."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))

from intercept_core import (  # noqa: E402
    ALLOWED_DECISIONS,
    append_jsonl,
    backtest_gate,
    decide,
    gate_path,
    promote_gate,
    read_jsonl,
    runtime_paths,
    status_gate,
    train_gate,
    utc_now,
    warn,
)

VERSION = "0.2.0"


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="intercept",
        description="Adaptive decision gates: Haiku/default teacher -> shadow canary -> local classifier.",
    )
    parser.add_argument("--version", action="version", version=f"intercept {VERSION}")
    subparsers = parser.add_subparsers(dest="command")

    decide_parser = subparsers.add_parser(
        "decide", help="make and log a fail-open production decision"
    )
    decide_parser.add_argument("gate")
    decide_parser.add_argument("--input", required=True, help="JSON object")

    label_parser = subparsers.add_parser(
        "label", help="append an explicit outcome label for a decision ID"
    )
    label_parser.add_argument("gate")
    label_parser.add_argument("decision_id")
    label_parser.add_argument("label", choices=ALLOWED_DECISIONS)

    train_parser = subparsers.add_parser(
        "train", help="train and evaluate an inactive JSON candidate model"
    )
    train_parser.add_argument("gate")

    promote_parser = subparsers.add_parser(
        "promote", help="verify candidate accuracy and begin persisted shadow canary"
    )
    promote_parser.add_argument("gate")

    backtest_parser = subparsers.add_parser(
        "backtest", help="evaluate candidate/active model against explicit-or-teacher labels"
    )
    backtest_parser.add_argument("gate")
    backtest_parser.add_argument("--since", help="lookback such as 30m, 12h, 7d, or 2w")

    status_parser = subparsers.add_parser(
        "status", help="show truthful counts, model lifecycle, metrics, and canary progress"
    )
    status_parser.add_argument("gate", nargs="?")
    return parser


def command_label(gate: str, decision_id: str, label: str) -> dict[str, str]:
    gate_path(gate)
    paths = runtime_paths(gate)
    matching = [
        row
        for row in read_jsonl(paths["decisions"])
        if row.get("gate") == gate and str(row.get("decision_id")) == decision_id
    ]
    if not matching:
        raise ValueError(f"decision ID {decision_id} was not found for gate {gate}")
    record = {
        "gate": gate,
        "decision_id": decision_id,
        "label": label,
        "timestamp": utc_now(),
        "source": "explicit",
    }
    append_jsonl(paths["labels"], record)
    return record


def command_status(gate: str | None) -> None:
    if gate:
        print(json.dumps(status_gate(gate), sort_keys=True))
        return
    gates_dir = Path(os.environ.get("INTERCEPT_GATES", ROOT / "gates"))
    for path in sorted(gates_dir.glob("*.yaml")):
        print(json.dumps(status_gate(path.stem, path), sort_keys=True))


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return 0

    if args.command == "decide":
        # This command is a caller safety boundary: never let runtime/model/LLM
        # failures turn a fail-open gate into a blocked caller.
        try:
            output = decide(args.gate, args.input)
        except Exception as exc:
            warn(f"fatal decision error ({exc}); using fail-open PROCEED")
            output = "PROCEED"
        print(output)
        return 0

    try:
        if args.command == "label":
            print(json.dumps(command_label(args.gate, args.decision_id, args.label), sort_keys=True))
        elif args.command == "train":
            path = gate_path(args.gate)
            paths = runtime_paths(args.gate)
            metrics = train_gate(
                args.gate, paths["decisions"], path, paths["candidate"], paths["labels"]
            )
            print(json.dumps(metrics, sort_keys=True))
        elif args.command == "promote":
            print(json.dumps(promote_gate(args.gate), sort_keys=True))
        elif args.command == "backtest":
            print(json.dumps(backtest_gate(args.gate, args.since), sort_keys=True))
        elif args.command == "status":
            command_status(args.gate)
        else:
            parser.error(f"unknown command {args.command}")
    except Exception as exc:
        print(f"intercept {args.command}: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
